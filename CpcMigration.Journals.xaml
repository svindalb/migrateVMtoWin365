<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saved migration journals" Width="1200" Height="740" MinWidth="900" MinHeight="550" WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#E2E8F0" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#0369A1"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="Saved migration journals" FontSize="25" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#BAE6FD" Text="Choose by VM, user and phase—not filename age alone. KEEP rows are unfinished migrations. Empty startup journals and unused drafts can be archived; completed plans remain recoverable. No cloud resources are changed."/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Name="Refresh" Content="Refresh list"/><Button Name="Browse" Content="Browse another journal…"/><CheckBox Name="ShowArchived" Content="Show archived" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
    <DataGrid Name="Journals" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" Background="#F8FAFC" Foreground="#0F172A" RowBackground="White" AlternatingRowBackground="#EFF6FF" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Open here" Binding="{Binding Current}" Width="75"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Kind}" Width="200"/>
        <DataGridTextColumn Header="VM · phase · user" Binding="{Binding Summary}" Width="350"/>
        <DataGridTextColumn Header="Last saved UTC" Binding="{Binding ModifiedUtc}" Width="170"/>
        <DataGridCheckBoxColumn Header="Archived" Binding="{Binding Archived}" Width="75"/>
        <DataGridTextColumn Header="Plan ID" Binding="{Binding PlanId}" Width="285"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBox Name="Details" Grid.Row="3" Margin="0,12,0,12" Background="#172A45" Foreground="#E2E8F0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10" Text="Select a journal to see its full path, scope and archive eligibility. Locks are checked when archiving. No selection is made automatically."/>
    <WrapPanel Grid.Row="4"><Button Name="Resume" Content="Resume selected" IsEnabled="False"/><Button Name="Archive" Content="Archive selected…" IsEnabled="False" Background="#92400E"/><Button Name="Close" Content="Close" Background="#334155"/></WrapPanel>
  </Grid>
</Window>